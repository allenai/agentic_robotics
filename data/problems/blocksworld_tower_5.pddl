(define (problem blocksworld_tower_5)
    (:domain blocks-tamp)
    ; Blocksworld release task, family tower, 5 color cubes.
    ; Start: every block on the table. Optimal plan: 8 skills.
    ; Generated by examples/agent/task_gen/generate_blocksworld_problems.py; regenerate rather than edit.
    (:objects
    block_yellow block_purple block_red1 block_green block_blue - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_yellow workspace_table)
        (on_table block_purple workspace_table)
        (on_table block_red1 workspace_table)
        (on_table block_green workspace_table)
        (on_table block_blue workspace_table)

        (clear block_yellow)
        (clear block_purple)
        (clear block_red1)
        (clear block_green)
        (clear block_blue)

        (handempty robot)

        (ori_of block_yellow o8)
        (ori_of block_purple o8)
        (ori_of block_red1 o8)
        (ori_of block_green o8)
        (ori_of block_blue o8)

        (gripper_at_init)
    )
    (:goal (and
        (on block_yellow block_purple)
        (on block_purple block_red1)
        (on block_red1 block_green)
        (on block_green block_blue)
    ))
)

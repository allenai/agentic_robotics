(define (problem stack_outside_adjacent_rotate_06)
    (:domain blocks-tamp)
    ; LEAP evaluation cell region=outside proximity=adjacent skill=rotate.
    ; Tower block_i on block_2 at o2; loose block block_a starts at o4 in region near_robot; block_2 2-3 cm beside it.
    ; Generated by scripts/task_gen/generate_leap_problems.py; regenerate rather than edit.
    (:objects
    block_a - block_letter
    block_i - block_letter
    block_2 - block_digit
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_2 workspace_table)
        (on_table block_a workspace_table)
        (in_region block_a near_robot)
        (near block_2 block_a)
        (on block_i block_2)

        (clear block_i)
        (clear block_a)

        (handempty robot)

        (ori_of block_2 o2)
        (ori_of block_i o2)
        (ori_of block_a o4)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)

    block_blue block_green block_orange block_yellow block_purple block_red1 - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_blue workspace_table)
        (on_table block_green workspace_table)
        (on_table block_orange workspace_table)
        (on_table block_yellow workspace_table)
        (on_table block_purple workspace_table)
        (on_table block_red1 workspace_table)

        (clear block_blue)
        (clear block_green)
        (clear block_orange)
        (clear block_yellow)
        (clear block_purple)
        (clear block_red1)

        (handempty robot)

        (ori_of block_blue o8)
        (ori_of block_green o8)
        (ori_of block_orange o8)
        (ori_of block_yellow o8)
        (ori_of block_purple o8)
        (ori_of block_red1 o8)

        (gripper_at_init)

(define (problem blocksworld_tower_6)
    (:domain blocks-tamp)
    ; Blocksworld release task, family tower, 6 color cubes.
    ; Start: every block on the table. Optimal plan: 10 skills.
    ; Generated by scripts/task_gen/generate_blocksworld_problems.py; regenerate rather than edit.

(define (problem blocksworld_sussman_5)
    (:domain blocks-tamp)
    ; Blocksworld release task, family sussman, 5 color cubes.
    ; Start: blue on purple; red on yellow. Optimal plan: 10 skills.
    ; Generated by examples/agent/task_gen/generate_blocksworld_problems.py; regenerate rather than edit.
    (:objects
    block_purple block_yellow block_green block_red1 block_blue - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_purple workspace_table)
        (on_table block_yellow workspace_table)
        (on_table block_green workspace_table)
        (on block_blue block_purple)
        (on block_red1 block_yellow)

        (clear block_green)
        (clear block_red1)
        (clear block_blue)

        (handempty robot)

        (ori_of block_purple o8)
        (ori_of block_yellow o8)
        (ori_of block_green o8)
        (ori_of block_red1 o8)
        (ori_of block_blue o8)

        (gripper_at_init)
    )
    (:goal (and
        (on block_purple block_yellow)
        (on block_yellow block_green)
        (on block_green block_red1)
        (on block_red1 block_blue)
    ))
)

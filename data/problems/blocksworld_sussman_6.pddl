(define (problem blocksworld_sussman_6)
    (:domain blocks-tamp)
    ; Blocksworld release task, family sussman, 6 color cubes.
    ; Start: orange on green; yellow on red; purple on blue. Optimal plan: 12 skills.
    ; Generated by examples/agent/task_gen/generate_blocksworld_problems.py; regenerate rather than edit.
    (:objects
    block_green block_red1 block_blue block_purple block_yellow block_orange - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_green workspace_table)
        (on_table block_red1 workspace_table)
        (on_table block_blue workspace_table)
        (on block_orange block_green)
        (on block_yellow block_red1)
        (on block_purple block_blue)

        (clear block_purple)
        (clear block_yellow)
        (clear block_orange)

        (handempty robot)

        (ori_of block_green o8)
        (ori_of block_red1 o8)
        (ori_of block_blue o8)
        (ori_of block_purple o8)
        (ori_of block_yellow o8)
        (ori_of block_orange o8)

        (gripper_at_init)
    )
    (:goal (and
        (on block_green block_red1)
        (on block_red1 block_blue)
        (on block_blue block_purple)
        (on block_purple block_yellow)
        (on block_yellow block_orange)
    ))
)

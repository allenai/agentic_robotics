(define (problem ai2_medium_05)
    (:domain blocks-tamp)
    ; The Ai2 stack with only A, I and 2 on the table and no distractors, as in ai2_easy, but each
    ; block starts at an orientation drawn at random over o1..o24 (this variant: block_a o5, block_i o4, block_2 o20). Face five
    ; carries a block's named glyph and is forward only at o2, o6, o10 and o14, so a block may or
    ; may not start readable, and may need turning before it is stacked at o2.
    ; Generated by examples/agent/task_gen/generate_ai2_medium_problems.py; regenerate rather than edit.
    (:objects
    block_a - block_a_n
    block_i - block_i_v
    block_2 - block_2_6
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_a workspace_table)
        (on_table block_i workspace_table)
        (on_table block_2 workspace_table)

        (clear block_a)
        (clear block_i)
        (clear block_2)

        (handempty robot)

        (ori_of block_a o5)
        (ori_of block_i o4)
        (ori_of block_2 o20)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)

(define (problem letter_probe_a)
    (:domain blocks-tamp)
    (:objects
    block_a block_b block_i block_o block_r block_t block_d block_j block_n block_u block_v block_y - block_letter
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_a workspace_table)
        (on_table block_b workspace_table)
        (on_table block_i workspace_table)
        (on_table block_o workspace_table)
        (on_table block_r workspace_table)
        (on_table block_t workspace_table)
        (on_table block_d workspace_table)
        (on_table block_j workspace_table)
        (on_table block_n workspace_table)
        (on_table block_u workspace_table)
        (on_table block_v workspace_table)
        (on_table block_y workspace_table)
        (clear block_a)
        (clear block_b)
        (clear block_i)
        (clear block_o)
        (clear block_r)
        (clear block_t)
        (clear block_d)
        (clear block_j)
        (clear block_n)
        (clear block_u)
        (clear block_v)
        (clear block_y)
        (ori_of block_a o16)
        (ori_of block_b o3)
        (ori_of block_i o5)
        (ori_of block_o o2)
        (ori_of block_r o11)
        (ori_of block_t o17)
        (ori_of block_d o7)
        (ori_of block_j o3)
        (ori_of block_n o8)
        (ori_of block_u o14)
        (ori_of block_v o3)
        (ori_of block_y o18)

        (gripper_at_init)
    )
    (:goal (and
        (on_table block_j workspace_table)
        (on block_v block_j)
        (on block_y block_v)
        (clear block_y)
        (ori_of block_j o2)
        (ori_of block_v o2)
        (ori_of block_y o2)
    ))
)

(define (problem blocksworld_invert_5)
    (:domain blocks-tamp)
    ; Blocksworld release task, family invert, 5 color cubes.
    ; Start: green on purple; yellow on blue. Optimal plan: 10 skills.
    ; Generated by examples/agent/task_gen/generate_blocksworld_problems.py; regenerate rather than edit.
    (:objects
    block_green block_purple block_yellow block_blue block_red1 - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_purple workspace_table)
        (on_table block_blue workspace_table)
        (on_table block_red1 workspace_table)
        (on block_green block_purple)
        (on block_yellow block_blue)

        (clear block_green)
        (clear block_yellow)
        (clear block_red1)

        (handempty robot)

        (ori_of block_green o8)
        (ori_of block_purple o8)
        (ori_of block_yellow o8)
        (ori_of block_blue o8)
        (ori_of block_red1 o8)

        (gripper_at_init)
    )
    (:goal (and
        (on block_purple block_green)
        (on block_red1 block_blue)
        (on block_blue block_yellow)
    ))
)

(define (problem rao_invert_6)
    (:domain blocks-tamp)
    ; Rao (Blocksworld) release task, family invert, 6 color cubes.
    ; Start: red on orange; orange on green; blue on yellow; yellow on purple. Optimal plan: 12 skills.
    ; Generated by examples/agent/task_gen/generate_rao_problems.py; regenerate rather than edit.
    (:objects
    block_red1 block_orange block_green block_blue block_yellow block_purple - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_green workspace_table)
        (on_table block_purple workspace_table)
        (on block_red1 block_orange)
        (on block_orange block_green)
        (on block_blue block_yellow)
        (on block_yellow block_purple)

        (clear block_red1)
        (clear block_blue)

        (handempty robot)

        (ori_of block_red1 o8)
        (ori_of block_orange o8)
        (ori_of block_green o8)
        (ori_of block_blue o8)
        (ori_of block_yellow o8)
        (ori_of block_purple o8)

        (gripper_at_init)
    )
    (:goal (and
        (on block_green block_orange)
        (on block_orange block_red1)
        (on block_purple block_yellow)
        (on block_yellow block_blue)
    ))
)

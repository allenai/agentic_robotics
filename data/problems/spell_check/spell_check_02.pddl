(define (problem spell_check_02)
    (:domain blocks-tamp)
    (:objects
    block_c block_h block_e block_c_2 block_k block_r block_s block_l block_u - block_letter
    block_green block_yellow block_red1 - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_c workspace_table)
        (on_table block_h workspace_table)
        (clear block_h)
        (on_table block_e workspace_table)
        (on_table block_c_2 workspace_table)
        (clear block_c_2)
        (on_table block_k workspace_table)
        (clear block_k)
        (on_table block_r workspace_table)
        (clear block_r)
        (on_table block_s workspace_table)
        (clear block_s)
        (on_table block_l workspace_table)
        (clear block_l)
        (on_table block_u workspace_table)
        (clear block_u)
        (on_table block_green workspace_table)
        (clear block_green)
        (on block_yellow block_c)
        (clear block_yellow)
        (on block_red1 block_e)
        (clear block_red1)
        (ori_of block_c o17)
        (ori_of block_h o9)
        (ori_of block_e o19)
        (ori_of block_c_2 o9)
        (ori_of block_k o1)
        (ori_of block_r o15)
        (ori_of block_s o3)
        (ori_of block_l o1)
        (ori_of block_u o8)
        (ori_of block_green o19)
        (ori_of block_yellow o24)
        (ori_of block_red1 o2)
        (handempty robot)
        (gripper_at_init)
    )
    (:goal (and
        (ori_of block_c o2)
        (ori_of block_h o2)
        (ori_of block_e o2)
    ))

    ;block_size_range = [0.03, 0.05]
    ;table_height_range = [0, 0.04]
    ;friction_range = [0.1, 0.4]
)
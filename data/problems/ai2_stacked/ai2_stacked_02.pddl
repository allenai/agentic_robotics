(define (problem ai2_stacked_02)
    (:domain blocks-tamp)
    (:objects
    block_a block_i block_c block_d block_n - block_letter
    block_2 block_blue block_gray2 block_cyan2 block_green block_blue4 block_purple2 - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on block_a block_blue)
        (on_table block_i workspace_table)
        (on block_2 block_gray2)
        (on block_c block_purple2)
        (on_table block_d workspace_table)
        (on_table block_n workspace_table)
        (on_table block_blue workspace_table)
        (on_table block_gray2 workspace_table)
        (on_table block_cyan2 workspace_table)
        (on_table block_green workspace_table)
        (on_table block_blue4 workspace_table)
        (on_table block_purple2 workspace_table)
        (clear block_a)
        (clear block_i)
        (clear block_2)
        (clear block_c)
        (clear block_d)
        (clear block_n)
        (clear block_cyan2)
        (clear block_green)
        (clear block_blue4)
        (handempty robot)

        (ori_of block_a o13)
        (ori_of block_i o14)
        (ori_of block_2 o17)
        (ori_of block_c o6)
        (ori_of block_d o18)
        (ori_of block_n o6)
        (ori_of block_blue o8)
        (ori_of block_gray2 o8)
        (ori_of block_cyan2 o1)
        (ori_of block_green o6)
        (ori_of block_blue4 o11)
        (ori_of block_purple2 o6)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)
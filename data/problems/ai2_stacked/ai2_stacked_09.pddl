(define (problem ai2_stacked_09)
    (:domain blocks-tamp)
    (:objects
    block_a block_i block_q block_v block_n - block_letter
    block_2 block_blue4 block_red5 block_blue block_cyan2 block_red1 block_green2 - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on_table block_a workspace_table)
        (on block_i block_a)
        (on block_2 block_i)
        (on_table block_q workspace_table)
        (on_table block_v workspace_table)
        (on block_n block_2)
        (on block_blue4 block_blue)
        (on block_red5 block_v)
        (on_table block_blue workspace_table)
        (on_table block_cyan2 workspace_table)
        (on_table block_red1 workspace_table)
        (on block_green2 block_blue4)
        (clear block_q)
        (clear block_n)
        (clear block_red5)
        (clear block_cyan2)
        (clear block_red1)
        (clear block_green2)
        (handempty robot)

        (ori_of block_a o24)
        (ori_of block_i o14)
        (ori_of block_2 o3)
        (ori_of block_q o9)
        (ori_of block_v o7)
        (ori_of block_n o13)
        (ori_of block_blue4 o9)
        (ori_of block_red5 o11)
        (ori_of block_blue o2)
        (ori_of block_cyan2 o7)
        (ori_of block_red1 o23)
        (ori_of block_green2 o1)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)
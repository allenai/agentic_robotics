(define (problem ai2_stacked_05)
    (:domain blocks-tamp)
    (:objects
    block_a block_i block_v block_k block_z - block_letter
    block_2 block_green3 block_gray block_gray2 block_cyan block_orange block_red1 - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on block_a block_i)
        (on block_i block_gray)
        (on_table block_2 workspace_table)
        (on_table block_v workspace_table)
        (on_table block_k workspace_table)
        (on block_z block_a)
        (on block_green3 block_red1)
        (on_table block_gray workspace_table)
        (on block_gray2 block_orange)
        (on block_cyan block_k)
        (on_table block_orange workspace_table)
        (on block_red1 block_2)
        (clear block_v)
        (clear block_z)
        (clear block_green3)
        (clear block_gray2)
        (clear block_cyan)
        (handempty robot)

        (ori_of block_a o6)
        (ori_of block_i o6)
        (ori_of block_2 o10)
        (ori_of block_v o11)
        (ori_of block_k o7)
        (ori_of block_z o18)
        (ori_of block_green3 o22)
        (ori_of block_gray o21)
        (ori_of block_gray2 o7)
        (ori_of block_cyan o6)
        (ori_of block_orange o23)
        (ori_of block_red1 o7)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)
(define (problem ai2_stacked_03)
    (:domain blocks-tamp)
    (:objects
    block_a block_i block_j block_u - block_letter
    block_2 block_red5 block_green3 block_purple2 block_yellow3 block_cyan block_purple - block
    block_t - block_t_g
    workspace_table - table
    robot - gripper    )
    (:init
        (on block_a block_cyan)
        (on_table block_i workspace_table)
        (on block_2 block_green3)
        (on_table block_j workspace_table)
        (on_table block_u workspace_table)
        (on_table block_t workspace_table)
        (on_table block_red5 workspace_table)
        (on_table block_green3 workspace_table)
        (on block_purple2 block_t)
        (on block_yellow3 block_a)
        (on_table block_cyan workspace_table)
        (on_table block_purple workspace_table)
        (clear block_i)
        (clear block_2)
        (clear block_j)
        (clear block_u)
        (clear block_red5)
        (clear block_purple2)
        (clear block_yellow3)
        (clear block_purple)
        (handempty robot)

        (ori_of block_a o3)
        (ori_of block_i o6)
        (ori_of block_2 o19)
        (ori_of block_j o2)
        (ori_of block_u o10)
        (ori_of block_t o1)
        (ori_of block_red5 o9)
        (ori_of block_green3 o16)
        (ori_of block_purple2 o20)
        (ori_of block_yellow3 o24)
        (ori_of block_cyan o13)
        (ori_of block_purple o23)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)
(define (problem ai2_stacked_04)
    (:domain blocks-tamp)
    (:objects
    block_a block_i block_j block_l block_e - block_letter
    block_2 block_gray2 block_green4 block_yellow3 block_red5 block_red3 block_cyan2 - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on block_a block_e)
        (on block_i block_green4)
        (on_table block_2 workspace_table)
        (on_table block_j workspace_table)
        (on block_l block_red3)
        (on_table block_e workspace_table)
        (on_table block_gray2 workspace_table)
        (on_table block_green4 workspace_table)
        (on block_yellow3 block_cyan2)
        (on_table block_red5 workspace_table)
        (on block_red3 block_2)
        (on_table block_cyan2 workspace_table)
        (clear block_a)
        (clear block_i)
        (clear block_j)
        (clear block_l)
        (clear block_gray2)
        (clear block_yellow3)
        (clear block_red5)
        (handempty robot)

        (ori_of block_a o12)
        (ori_of block_i o3)
        (ori_of block_2 o20)
        (ori_of block_j o11)
        (ori_of block_l o22)
        (ori_of block_e o13)
        (ori_of block_gray2 o17)
        (ori_of block_green4 o8)
        (ori_of block_yellow3 o6)
        (ori_of block_red5 o8)
        (ori_of block_red3 o16)
        (ori_of block_cyan2 o9)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)
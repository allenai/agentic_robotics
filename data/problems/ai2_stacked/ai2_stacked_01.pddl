(define (problem ai2_stacked_01)
    (:domain blocks-tamp)
    (:objects
    block_a block_i block_f block_u block_d - block_letter
    block_2 block_blue4 block_red4 block_yellow3 block_yellow2 block_gray2 block_cyan - block
    workspace_table - table
    robot - gripper    )
    (:init
        (on block_a block_red4)
        (on block_i block_gray2)
        (on_table block_2 workspace_table)
        (on block_f block_yellow3)
        (on_table block_u workspace_table)
        (on block_d block_a)
        (on_table block_blue4 workspace_table)
        (on_table block_red4 workspace_table)
        (on_table block_yellow3 workspace_table)
        (on_table block_yellow2 workspace_table)
        (on block_gray2 block_f)
        (on_table block_cyan workspace_table)
        (clear block_i)
        (clear block_2)
        (clear block_u)
        (clear block_d)
        (clear block_blue4)
        (clear block_yellow2)
        (clear block_cyan)
        (handempty robot)

        (ori_of block_a o24)
        (ori_of block_i o1)
        (ori_of block_2 o17)
        (ori_of block_f o8)
        (ori_of block_u o15)
        (ori_of block_d o16)
        (ori_of block_blue4 o18)
        (ori_of block_red4 o8)
        (ori_of block_yellow3 o12)
        (ori_of block_yellow2 o8)
        (ori_of block_gray2 o22)
        (ori_of block_cyan o8)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)
(define (problem ai2_stacked_08)
    (:domain blocks-tamp)
    (:objects
    block_a block_i block_j block_n - block_letter
    block_2 block_red5 block_blue2 block_gray block_red2 block_red3 block_brown - block
    block_o - block_o_b
    workspace_table - table
    robot - gripper    )
    (:init
        (on block_a block_i)
        (on_table block_i workspace_table)
        (on_table block_2 workspace_table)
        (on_table block_j workspace_table)
        (on_table block_n workspace_table)
        (on_table block_o workspace_table)
        (on_table block_red5 workspace_table)
        (on_table block_blue2 workspace_table)
        (on block_gray block_blue2)
        (on block_red2 block_n)
        (on_table block_red3 workspace_table)
        (on_table block_brown workspace_table)
        (clear block_a)
        (clear block_2)
        (clear block_j)
        (clear block_o)
        (clear block_red5)
        (clear block_gray)
        (clear block_red2)
        (clear block_red3)
        (clear block_brown)
        (handempty robot)

        (ori_of block_a o22)
        (ori_of block_i o9)
        (ori_of block_2 o4)
        (ori_of block_j o3)
        (ori_of block_n o13)
        (ori_of block_o o20)
        (ori_of block_red5 o13)
        (ori_of block_blue2 o4)
        (ori_of block_gray o22)
        (ori_of block_red2 o2)
        (ori_of block_red3 o11)
        (ori_of block_brown o8)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)
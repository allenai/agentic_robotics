(define (problem ai2_stacked_06)
    (:domain blocks-tamp)
    (:objects
    block_a block_i block_u block_d - block_letter
    block_2 block_pink block_blue4 block_red2 block_red1 block_red5 block_purple - block
    block_r - block_r_e
    workspace_table - table
    robot - gripper    )
    (:init
        (on block_a block_red5)
        (on_table block_i workspace_table)
        (on_table block_2 workspace_table)
        (on_table block_u workspace_table)
        (on_table block_d workspace_table)
        (on block_r block_pink)
        (on_table block_pink workspace_table)
        (on_table block_blue4 workspace_table)
        (on_table block_red2 workspace_table)
        (on_table block_red1 workspace_table)
        (on_table block_red5 workspace_table)
        (on_table block_purple workspace_table)
        (clear block_a)
        (clear block_i)
        (clear block_2)
        (clear block_u)
        (clear block_d)
        (clear block_r)
        (clear block_blue4)
        (clear block_red2)
        (clear block_red1)
        (clear block_purple)
        (handempty robot)

        (ori_of block_a o3)
        (ori_of block_i o14)
        (ori_of block_2 o11)
        (ori_of block_u o3)
        (ori_of block_d o12)
        (ori_of block_r o14)
        (ori_of block_pink o9)
        (ori_of block_blue4 o15)
        (ori_of block_red2 o23)
        (ori_of block_red1 o4)
        (ori_of block_red5 o7)
        (ori_of block_purple o23)

        (gripper_at_init)
    )
    (:goal (and
        (on block_a block_i)
        (on block_i block_2)
        (ori_of block_a o2)
        (ori_of block_i o2)
        (ori_of block_2 o2)
    ))
)